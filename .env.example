# Copy to .env and adjust. Never commit real secrets.

# SQL Server (used by docker-compose)
MSSQL_SA_PASSWORD=Your_strong_Password123
MSSQL_DATABASE=PromotionMonitor

# JWT — use a long random string in any non-local environment
JWT_KEY=dev-only-change-me-to-a-long-random-secret-key-32chars
JWT_ISSUER=PromotionMonitor
JWT_AUDIENCE=PromotionMonitor
JWT_EXPIRY_HOURS=24

# SMTP — leave empty to use clearly labeled simulated email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLE_SSL=true

# Shipping API — leave empty to use SimulatedCep quotes
SHIPPING_API_URL=
SHIPPING_API_KEY=

# Public URLs (compose)
API_PUBLIC_URL=http://localhost:45881
WEB_PUBLIC_URL=http://localhost:45173
